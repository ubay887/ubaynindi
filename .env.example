# Required: public origin, without a trailing slash.
APP_ORIGIN=https://ubaynindi.love
# Optional comma-separated exact origins when both apex and www are served.
APP_ALLOWED_ORIGINS=https://www.ubaynindi.love
DATABASE_URL=postgres://user:password@host:5432/database
RATE_LIMIT_HMAC_SECRET=replace-with-at-least-32-random-characters

# Optional: only enable after Coolify is proven to overwrite this header.
TRUSTED_PROXY_HEADER=
TRUSTED_PROXY_VERIFIED=false

# Optional public metadata fallback.
SITE_URL=https://ubaynindi.love

# Optional guestbook moderation through the Telegram bot.
# TELEGRAM_ADMIN_IDS is a comma-separated list of numeric Telegram user ids.
# Send /id to the bot in a private chat to learn the id. List and delete stay closed until this is set.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=

# Optional pool tuning is intentionally bounded in code; do not expose a large pool.
